[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]
macos.debug = "res://bin/macos/libplayer.dylib"
macos.release = "res://bin/macos/libplayer.dylib"
windows.debug.x86_64 = "res://bin/windows/player.dll"
windows.release.x86_64 = "res://bin/windows/player.dll"
linux.debug.x86_64 = "res://bin/linux/libplayer.so"
linux.release.x86_64 = "res://bin/linux/libplayer.so"
